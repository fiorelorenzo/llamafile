-   stbiw__wptag(o, "IHDR");
-   stbiw__wp32(o, x);
-   stbiw__wp32(o, y);
-   *o++ = 8;
-   *o++ = STBIW_UCHAR(ctype[n]);
-   *o++ = 0;
-   *o++ = 0;
-   *o++ = 0;
-   stbiw__wpcrc(&o,13);
-
-   if(parameters != NULL) {
-      stbiw__wp32(o, param_length);
-      stbiw__wptag(o, "tEXt");
-      STBIW_MEMMOVE(o, "parameters", strlen("parameters"));
-      o+=strlen("parameters");
-      *o++ = 0; // Null pyte separator
-      STBIW_MEMMOVE(o, parameters, strlen(parameters));
-      o+=strlen(parameters);
-      stbiw__wpcrc(&o, param_length);
-   }
-
-   stbiw__wp32(o, zlen);
-   stbiw__wptag(o, "IDAT");
-   STBIW_MEMMOVE(o, zlib, zlen);
-   o += zlen;
-   STBIW_FREE(zlib);
-   stbiw__wpcrc(&o, zlen);
-
-   stbiw__wp32(o,0);
-   stbiw__wptag(o, "IEND");
